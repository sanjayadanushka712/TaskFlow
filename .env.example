# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
#
# Docker Compose loads .env automatically from the project root.

# PostgreSQL container credentials
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev
POSTGRES_DB=taskflow

# Host port used to expose PostgreSQL for local tools.
# The API container connects through the internal Docker network on 5432.
POSTGRES_PORT=5433

# API host port
API_PORT=8000

# Connection string used by the API and Alembic inside Docker Compose.
# For running the app directly on the host, use localhost:${POSTGRES_PORT}.
DATABASE_URL=postgresql+psycopg://taskflow:taskflow_dev@db:5432/taskflow
